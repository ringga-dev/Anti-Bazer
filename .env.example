# Copy this file to .env and fill only credentials for apps you own/manage.
# Never commit .env or share access tokens.

# X API
X_BEARER_TOKEN=

# Instagram Graph API (Meta)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=

# TikTok Display API OAuth
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Facebook Graph API (Meta)
FACEBOOK_ACCESS_TOKEN=

# AI analysis (opt-in). Use an OpenAI-compatible chat-completions endpoint.
# For a local Hermes/OpenClaw server, set its local endpoint URL and model name.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Collection limits
MAX_SCAN_POSTS=5
MAX_SCAN_COMMENTS=500
X_MAX_SEARCH_PAGES=5
YOUTUBE_MAX_COMMENT_PAGES=3
META_MAX_COMMENT_PAGES=5

# HTTP API (start with: bun run api)
API_HOST=127.0.0.1
API_PORT=3000
API_ACCESS_TOKEN=
API_CORS_ORIGIN=
API_MAX_CONCURRENT_SCANS=2
